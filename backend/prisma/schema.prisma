// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  emailAddress String        @unique
  password     String
  name         String       @db.VarChar(255)
  userType     String        @db.VarChar(255)
  postedJobs   Job[]         @relation("PostedJobs")
  applications Application[]
}

model Job {
  id          String  @id @default(cuid())
  title       String  @db.VarChar(255)
  company     String  @db.VarChar(255)
  location    String  @db.VarChar(255)
  jobType     String  @db.VarChar(255)
  description String  @db.Text
  salary      String?

  postedAt   DateTime @default(now())
  postedBy   User     @relation("PostedJobs", fields: [postedById], references: [id])
  postedById String // automatically set by postedBy relation when a Job is created

  applications Application[]
}

model Application {
  id        String   @id @default(cuid())
  status    String   @default("pending") // pending, accepted, rejected
  appliedAt DateTime @default(now())

  // Relation to the Job
  job   Job    @relation(fields: [jobId], references: [id])
  jobId String

  // Relation to the User who is applying
  applicant   User   @relation(fields: [applicantId], references: [id])
  applicantId String

  // Block a user from applying to the same job twice 
  @@unique([jobId, applicantId])
}
